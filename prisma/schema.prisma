generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String?
  name     String?
  image    String?
  emailVerified DateTime?

  isAdmin       Boolean   @default(false) // 👈 מזהה אם המשתמש הוא מנהל
  timeSpentMins Int       @default(0)     // 👈 סופר כמה דקות המשתמש בילה באתר
  updatedAt DateTime @default(now()) @updatedAt
  accounts Account[]
  sessions Session[]
  points       Point[]
  viewedPoints ViewedPoint[]
  savedPoints  SavedPoint[]
  notifications Notification[]
  platform      String?  @default("WEB") // יכול להיות "WEB" או "PWA"
  country       String?
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?

  token_type   String?
  scope        String?
  id_token     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Point {
  id          Int @id @default(autoincrement())
  name        String
  category    String
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  description String?
  address     String?
  website     String?
  imageUrl    String?
  imageUrls   String[]  @default([])
  extraInfo   String?
  userId String?
  linkClicks  Int      @default(0)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedBy     ViewedPoint[]
  savedBy     SavedPoint[]
}

model ViewedPoint {
  id        Int      @id @default(autoincrement())
  userId    String
  pointId   Int
  viewedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  point     Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)

  // מוודא שלכל משתמש תהיה רשומה אחת לכל נקודה, ואנחנו פשוט נעדכן את זמן הצפייה
  @@unique([userId, pointId]) 
}

model SavedPoint {
  id        Int      @id @default(autoincrement())
  userId    String
  pointId   Int
  savedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  point     Point    @relation(fields: [pointId], references: [id], onDelete: Cascade)

  // מונע שמירה כפולה של אותה נקודה על ידי אותו משתמש
  @@unique([userId, pointId]) 
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   // 👈 שימי לב: אם ה-id של ה-User שלך מוגדר כ-Int, תשני כאן ל-Int במקום String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Visitor {
  id            String   @id
  platform      String   @default("WEB")
  timeSpentMins Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}